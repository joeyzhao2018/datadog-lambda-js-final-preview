{
  "name": "datadog-lambda-js",
  "version": "13.0.0",
  "description": "Datadog AWS Lambda entry points and layer packaging. Tracing and metrics live in dd-trace.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/copy_runtime_files.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:api-surface": "npm run build && node scripts/check_api_surface.js",
    "lint": "eslint .",
    "check-formatting": "prettier --check src/**"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts"
  ],
  "dependencies": {
    "serialize-error": "^8.1.0"
  },
  "peerDependencies": {
    "dd-trace": "^5.126.0 || ^6.12.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.136",
    "@types/jest": "^27.5.2",
    "@types/node": "^20.12.10",
    "dd-trace": "^6.12.0",
    "jest": "^27.0.1",
    "prettier": "^2.3.0",
    "ts-jest": "^27.0.1",
    "typescript": "^4.3.2"
  }
}
